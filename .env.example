# Copy to .env.local and fill in. Never commit real values.
# Leave the Supabase values empty to run in local mode (data stays in this browser).

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable (anon) key. Safe for the browser because row-level security protects every table.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Web Push public VAPID key (the private key lives only in Supabase function secrets).
VITE_VAPID_PUBLIC_KEY=

# Optional: Google OAuth web client ID (ends in .apps.googleusercontent.com). Public, safe for the browser.
# The client SECRET goes only in Supabase -> Authentication -> Providers -> Google, never here.
VITE_GOOGLE_CLIENT_ID=
